# Copy to deploy/.env (gitignored) and fill in. Never commit the real file.

# Public host name, pointed at the server with a DNS A record (GoDaddy: DNS > Add record > A).
DOMAIN=physicalstudio.example.com

# Gemini key from https://aistudio.google.com/apikey. Stays on the server; browsers only get
# single-use tokens.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Model that judges each camera frame against the step (structured JSON verdicts).
GEMINI_CHECK_MODEL=gemini-3.8-flash
# When Gemini is rate limited (free tier: 5 checks a minute), DeepSeek's vision model judges the
# frame instead. DEEPSEEK_API_KEY below is shared with the design jobs.
DEEPSEEK_CHECK_MODEL=deepseek-flash

# Model for Circuit Studio at /studio/ (photos + wiring notes -> breadboard 3D model).
GEMINI_STUDIO_MODEL=gemini-3.8-flash

# Optional: if set, the camera check only works when the page is opened with ?code=<DEMO_CODE>,
# so strangers can't spend the Gemini quota.
DEMO_CODE=

# Camera sessions one IP can start per minute, and step checks (one every 4 s while watching).
TOKENS_PER_MINUTE=6
CHECKS_PER_MINUTE=30

# Models for the "Describe" screen, which designs projects from a prompt (one design at a time;
# DESIGNS_PER_HOUR per IP; DEMO_CODE above also guards it). Tried in DESIGN_PROVIDERS order,
# skipping any without a key; if OpenAI runs out of quota mid-design, DeepSeek carries on.
DESIGN_PROVIDERS=openai,deepseek,anthropic
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-6.1-sol
DEEPSEEK_API_KEY=
DEEPSEEK_DESIGN_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
DESIGN_MODEL=claude-opus-5-5
DESIGNS_PER_HOUR=4

# Bearer token for the hosted MCP server. Generate one: openssl rand -hex 24
MCP_TOKEN=

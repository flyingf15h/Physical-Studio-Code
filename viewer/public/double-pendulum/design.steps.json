  "steps": [
    {
      "index": 1,
      "title": "Lay out the base plate",
      "text": "Put the base plate on the table with its long front edge right at the table edge.",
      "add": [
        "base-plate"
      ],
      "check": "The base plate lies flat with its front edge at the edge of the table."
    },
    {
      "index": 2,
      "title": "Screw down the linear rail",
      "text": "Lay the rail along the base, 35 mm in from the back of the front strip, and screw it down with M5 screws.",
      "add": [
        "rail"
      ],
      "motion": [
        {
          "placement": "rail",
          "from_offset": [
            0,
            0,
            40
          ]
        }
      ],
      "tools": [
        {
          "name": "4 mm hex key",
          "for": "M5 rail screws"
        }
      ],
      "check": "The rail runs straight along the base, 50 mm from each end."
    },
    {
      "index": 3,
      "title": "Slide on the carriage block",
      "text": "Slide the carriage block onto the rail from one end. Keep it level so the balls stay in.",
      "add": [
        "block"
      ],
      "motion": [
        {
          "placement": "block",
          "from_offset": [
            -260,
            0,
            0
          ]
        }
      ],
      "callouts": [
        {
          "text": "Slide on from the end, don't lift it off again",
          "target": "block"
        }
      ],
      "check": "The block sits on the rail and slides end to end smoothly."
    },
    {
      "index": 4,
      "title": "Fit the rack riser",
      "text": "Screw the rack riser along the back of the base, parallel to the rail.",
      "add": [
        "riser"
      ],
      "motion": [
        {
          "placement": "riser",
          "from_offset": [
            0,
            0,
            40
          ]
        }
      ],
      "check": "The riser runs along the back edge, parallel to the rail."
    },
    {
      "index": 5,
      "title": "Fit the gear rack",
      "text": "Screw the rack on top of the riser with its teeth facing the rail.",
      "add": [
        "rack"
      ],
      "motion": [
        {
          "placement": "rack",
          "from_offset": [
            0,
            0,
            40
          ]
        }
      ],
      "callouts": [
        {
          "text": "Teeth face the rail",
          "target": "rack"
        }
      ],
      "check": "The rack sits on the riser with its teeth facing the rail."
    },
    {
      "index": 6,
      "title": "Bolt on the cart plate",
      "text": "Put the cart plate on the carriage block, motor hole at the back over the rack, and bolt it down with 4 M5 screws.",
      "add": [
        "cart"
      ],
      "motion": [
        {
          "placement": "cart",
          "from_offset": [
            0,
            0,
            40
          ]
        }
      ],
      "tools": [
        {
          "name": "4 mm hex key",
          "for": "M5 cart screws"
        }
      ],
      "check": "The cart plate sits flat on the block with its hole above the rack."
    },
    {
      "index": 7,
      "title": "Mount the drive motor",
      "text": "Stand the motor on the cart plate and push its shaft down through the hole. Screw it to the plate.",
      "add": [
        "motor"
      ],
      "motion": [
        {
          "placement": "motor",
          "from_offset": [
            0,
            0,
            60
          ]
        }
      ],
      "check": "The motor stands upright on the cart with its shaft through the plate."
    },
    {
      "index": 8,
      "title": "Fit the pinion gear",
      "text": "From underneath, push the pinion onto the motor shaft so it meshes with the rack, then tighten its set screw.",
      "add": [
        "pinion"
      ],
      "motion": [
        {
          "placement": "pinion",
          "from_offset": [
            0,
            0,
            -25
          ]
        }
      ],
      "tools": [
        {
          "name": "2 mm hex key",
          "for": "pinion set screw"
        }
      ],
      "callouts": [
        {
          "text": "Teeth mesh with the rack, no gap",
          "target": "pinion"
        }
      ],
      "check": "The pinion is on the motor shaft under the cart and its teeth sit in the rack."
    },
    {
      "index": 9,
      "title": "Screw on the pivot block",
      "text": "Screw the pivot block to the front of the cart plate, its big hole running front to back.",
      "add": [
        "pivot"
      ],
      "motion": [
        {
          "placement": "pivot",
          "from_offset": [
            0,
            0,
            40
          ]
        }
      ],
      "check": "The pivot block sits at the front of the cart with its hole running front to back."
    },
    {
      "index": 10,
      "title": "Press in the front cart bearing",
      "text": "Press a flanged bearing into the front of the pivot block, flange outside.",
      "add": [
        "bearing-front"
      ],
      "motion": [
        {
          "placement": "bearing-front",
          "from_offset": [
            0,
            -40,
            0
          ]
        }
      ],
      "check": "A bearing flange sits flat on the front face of the pivot block."
    },
    {
      "index": 11,
      "title": "Press in the back cart bearing",
      "text": "Press the second bearing into the back of the pivot block, flange outside.",
      "add": [
        "bearing-back"
      ],
      "motion": [
        {
          "placement": "bearing-back",
          "from_offset": [
            0,
            40,
            0
          ]
        }
      ],
      "check": "A bearing flange sits flat on the back face of the pivot block."
    },
    {
      "index": 12,
      "title": "Fit the lower arm",
      "text": "Hold the lower arm in front of the pivot block, its small hole lined up with the bearings.",
      "add": [
        "arm-lower"
      ],
      "motion": [
        {
          "placement": "arm-lower",
          "from_offset": [
            0,
            -60,
            0
          ]
        }
      ],
      "check": "The lower arm stands in front of the cart, small hole at the bottom by the bearings."
    },
    {
      "index": 13,
      "title": "Slide in the cart shaft",
      "text": "Push the 48 mm shaft from the front through the arm and both bearings, then clamp the arm to it.",
      "add": [
        "shaft-cart"
      ],
      "motion": [
        {
          "placement": "shaft-cart",
          "from_offset": [
            0,
            -50,
            0
          ]
        }
      ],
      "tools": [
        {
          "name": "2 mm hex key",
          "for": "arm clamp screw"
        }
      ],
      "check": "The shaft passes through the arm and both bearings and pokes out of the back of the pivot block."
    },
    {
      "index": 14,
      "title": "Glue on the cart magnet",
      "text": "Glue the round magnet centred on the back end of the cart shaft.",
      "add": [
        "magnet-cart"
      ],
      "callouts": [
        {
          "text": "Centred on the shaft end",
          "target": "magnet-cart"
        }
      ],
      "check": "A small round magnet sits in the middle of the shaft's back end."
    },
    {
      "index": 15,
      "title": "Fit the cart encoder mount",
      "text": "Screw the encoder mount to the cart behind the pivot block, its hole around the magnet.",
      "add": [
        "mount-cart"
      ],
      "motion": [
        {
          "placement": "mount-cart",
          "from_offset": [
            0,
            30,
            0
          ]
        }
      ],
      "check": "The mount stands behind the pivot block and the magnet is inside its hole."
    },
    {
      "index": 16,
      "title": "Screw on the cart encoder",
      "text": "Screw an AS5600 board to the back of the mount, chip facing the magnet.",
      "add": [
        "enc-cart"
      ],
      "motion": [
        {
          "placement": "enc-cart",
          "from_offset": [
            0,
            30,
            0
          ]
        }
      ],
      "callouts": [
        {
          "text": "Chip side faces the magnet",
          "target": "enc-cart"
        }
      ],
      "check": "The encoder board covers the mount's hole, pins at the bottom."
    },
    {
      "index": 17,
      "title": "Press in the elbow bearing",
      "text": "Press a bearing into the big hole at the top of the lower arm, flange at the front.",
      "add": [
        "bearing-elbow"
      ],
      "motion": [
        {
          "placement": "bearing-elbow",
          "from_offset": [
            0,
            -40,
            0
          ]
        }
      ],
      "check": "A bearing flange sits on the front of the lower arm's top hole."
    },
    {
      "index": 18,
      "title": "Fit the upper arm",
      "text": "Hold the upper arm in front of the lower arm, its hole lined up with the elbow bearing.",
      "add": [
        "arm-upper"
      ],
      "motion": [
        {
          "placement": "arm-upper",
          "from_offset": [
            0,
            -60,
            0
          ]
        }
      ],
      "check": "The upper arm overlaps the top of the lower arm, in front of it."
    },
    {
